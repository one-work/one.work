<section class="hero is-cover">
  <div class="hero-body is-middle text-centered">
    <h1 class="title">
      <span>One Work</span>
      <div class="typer-wrap">
        <span class="invisible has-animate-typer" data-controller="animate-typer">一站式办公</span>
        <span class="display-none has-animate-typer" data-controller="animate-typer">超级个体平台</span>
        <span class="display-none has-animate-typer" data-controller="animate-typer">开源业务组件</span>
      </div>
    </h1>
    <h2 class="title">一人可开发的全栈系统</h2>
    <p class="text-grey-lighter">当数据量达到 5 万条或交易额达到 10 万元，才开始收取 390 元/年</p>
  </div>
  <div class="buttons are-large is-centered mb-4">
    <%= render 'links' %>
  </div>
</section>

<% @posts.each do |post| %>
  <div class="work_layout">
    <%= render partial: "md_layout/#{post.layout}", collection: post.raw_block_texts, as: :item %>
  </div>
<% end %>
