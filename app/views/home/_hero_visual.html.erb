<div class="hero-visual">
  <div class="hv-window">
    <div class="hv-window-bar">
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="hv-window-body">
      <div class="hv-sidebar">
        <span class="is-active"></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="hv-main">
        <div class="hv-chart">
          <span style="--h: 45%"></span>
          <span style="--h: 70%"></span>
          <span style="--h: 55%"></span>
          <span style="--h: 85%"></span>
          <span style="--h: 65%"></span>
          <span style="--h: 95%"></span>
        </div>
        <div class="hv-skeleton">
          <span></span>
          <span></span>
          <span class="is-short"></span>
        </div>
      </div>
    </div>
  </div>

  <div class="hv-card hv-card-revenue">
    <span class="hv-icon is-teal"><%= svg_tag 'chart-line' %></span>
    <div>
      <p class="hv-label">本月营收</p>
      <p class="hv-value">¥ 128,600<em>+32%</em></p>
    </div>
  </div>

  <div class="hv-card hv-card-approve">
    <span class="hv-icon is-yellow"><%= svg_tag 'circle-check' %></span>
    <div>
      <p class="hv-label">审批流转</p>
      <p class="hv-value">报销单已通过</p>
    </div>
  </div>

  <div class="hv-card hv-card-component">
    <span class="hv-icon is-blue"><%= svg_tag 'cubes' %></span>
    <div>
      <p class="hv-label">开源业务组件</p>
      <p class="hv-value">开箱即用</p>
    </div>
  </div>
</div>
