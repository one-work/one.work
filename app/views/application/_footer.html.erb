<footer class="footer">
  <div class="container">
    <div class="columns">
      <div class="column">
        <p class="size-7 text-grey mb-2">开源</p>
        <a href="https://github.com/one-work" target="_blank" ref="nofollow" class="text-grey display-block">
          <%= svg_tag 'github', kind: 'brands' %>
          <span class="ml-1">Github</span>
        </a>
      </div>
      <div class="column">
        <p class="size-7 text-grey mb-2">关于我们</p>
        <p>联系方式：+8618571856813</p>
      </div>
    </div>
    <div class="content text-centered mt-4">
      <div class="">©<%= Date.today.year %> <%= (defined?(current_organ) && current_organ&.name) || t('site_name') %></div>
      <div class="m-2">
        <a
          href="https://beian.miit.gov.cn"
          target="_blank"
          rel="nofollow"
        >
        <%= if defined?(current_organ_domain) && current_organ_domain %>
          <span class="text-grey"><%= current_organ_domain.beian %></span>
        <% else %>
          <span class="text-grey">鄂ICP备20004085号-6</span>
        <% end %>
        </a>
      </div>
    </div>
  </div>
</footer>
